{
  "manifest_version": 3,
  "name": "标签侧边栏",
  "version": "1.0",
  "description": "一个将标签页显示在侧边栏的浏览器扩展",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["sidePanel", "tabs", "storage"],
  "action": {
    "default_title": "打开侧边栏"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "TabSidebar.html"
  }
}
